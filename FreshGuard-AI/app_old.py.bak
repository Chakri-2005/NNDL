"""
FreshGuard AI — Flask Inference Server
Loads trained models (EfficientNetV2-S, ConvNeXt-Tiny, MobileViT) and serves real-time freshness predictions.
"""
import os
import sys
import io
import base64
import torch
import torch.nn.functional as F
from torchvision import transforms
from PIL import Image
from flask import Flask, request, jsonify, send_from_directory

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import config
from models import get_efficientnetv2_s, get_convnext_tiny, get_mobilevit

app = Flask(__name__, static_folder="slides/ui_mockups", static_url_path="")

# Device setup
device = config.DEVICE
print(f"Starting FreshGuard AI Server | Device: {device}")

# Available Models Registry
MODEL_REGISTRY = {
    "efficientnetv2_s": {
        "name": "EfficientNetV2-S",
        "get_fn": get_efficientnetv2_s,
        "ckpt": os.path.join(config.CHECKPOINTS_DIR, "efficientnetv2_s_best.pth")
    },
    "convnext_tiny": {
        "name": "ConvNeXt-Tiny",
        "get_fn": get_convnext_tiny,
        "ckpt": os.path.join(config.CHECKPOINTS_DIR, "convnext_tiny_best.pth")
    },
    "mobilevit": {
        "name": "MobileViT",
        "get_fn": get_mobilevit,
        "ckpt": os.path.join(config.CHECKPOINTS_DIR, "mobilevit_best.pth")
    }
}

# Pre-load available models into memory cache
LOADED_MODELS = {}

for m_key, m_info in MODEL_REGISTRY.items():
    ckpt_path = m_info["ckpt"]
    model_inst = m_info["get_fn"](num_classes=config.NUM_CLASSES, pretrained=False).to(device)
    if os.path.exists(ckpt_path):
        model_inst.load_state_dict(torch.load(ckpt_path, map_location=device))
        model_inst.eval()
        LOADED_MODELS[m_key] = model_inst
        print(f" Loaded model '{m_info['name']}' from {ckpt_path}")
    else:
        print(f" ⚠️ Warning: Checkpoint for '{m_info['name']}' not found at {ckpt_path}. Model available with initial weights.")
        model_inst.eval()
        LOADED_MODELS[m_key] = model_inst

# Preprocessing Pipeline (same as validation/testing)
preprocess = transforms.Compose([
    transforms.Resize((config.IMAGE_SIZE, config.IMAGE_SIZE)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
])

def get_verdict(class_name, confidence):
    fruit, status = class_name.split("_")
    if confidence < config.CONFIDENCE_THRESHOLD:
        return "UNCERTAIN", "#f59e0b", "⚠️"
    if status == "Fresh":
        return "FRESH", "#059669", "✅"
    else:
        return "ROTTEN", "#dc2626", "❌"

@app.route("/")
def index():
    return send_from_directory("slides/ui_mockups", "app.html")

@app.route("/models", methods=["GET"])
def get_available_models():
    """Returns list of available models for selection."""
    models_info = []
    for key, info in MODEL_REGISTRY.items():
        models_info.append({
            "key": key,
            "name": info["name"],
            "loaded": key in LOADED_MODELS
        })
    return jsonify({"models": models_info, "default": "efficientnetv2_s"})

@app.route("/predict", methods=["POST"])
def predict():
    try:
        data = request.get_json()
        if not data or "image" not in data:
            return jsonify({"error": "No image data provided"}), 400

        # Model selection parameter (default to efficientnetv2_s or mobilevit)
        selected_model_key = data.get("model", "efficientnetv2_s")
        if selected_model_key not in LOADED_MODELS:
            selected_model_key = list(LOADED_MODELS.keys())[0]

        target_model = LOADED_MODELS[selected_model_key]
        model_name = MODEL_REGISTRY[selected_model_key]["name"]

        # Decode base64 image
        image_b64 = data["image"]
        if "," in image_b64:
            image_b64 = image_b64.split(",")[1]

        image_bytes = base64.b64decode(image_b64)
        image = Image.open(io.BytesIO(image_bytes)).convert("RGB")

        # Preprocess & run inference
        tensor = preprocess(image).unsqueeze(0).to(device)

        with torch.no_grad():
            logits = target_model(tensor)
            probs = F.softmax(logits, dim=1)[0]

        confidence, pred_idx = torch.max(probs, dim=0)
        confidence = confidence.item()
        pred_class = config.CLASS_NAMES[pred_idx.item()]

        class_probs = {
            config.CLASS_NAMES[i]: round(probs[i].item() * 100, 2)
            for i in range(len(config.CLASS_NAMES))
        }

        fruit, status = pred_class.split("_")
        verdict, color, icon = get_verdict(pred_class, confidence)

        return jsonify({
            "class": pred_class,
            "fruit": fruit,
            "status": status,
            "verdict": verdict,
            "confidence": round(confidence * 100, 1),
            "color": color,
            "icon": icon,
            "all_probabilities": class_probs,
            "abstained": confidence < config.CONFIDENCE_THRESHOLD,
            "selected_model": model_name
        })

    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/health")
def health():
    return jsonify({
        "status": "ok", 
        "device": str(device), 
        "available_models": [info["name"] for info in MODEL_REGISTRY.values()]
    })

if __name__ == "__main__":
    print(f"Starting FreshGuard AI server on http://0.0.0.0:5050")
    app.run(host="0.0.0.0", port=5050, debug=False)
